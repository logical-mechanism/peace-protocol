# Veiled Desktop — Backend Environment Variables
# Copy this file to .env and adjust as needed:  cp .env.example .env

# ── Core ─────────────────────────────────────────────────────────────────────

# Express server port (default: 3001)
PORT=3001

# Node environment — "development" shows full error details; "production" returns generic messages
NODE_ENV=development

# Cardano network — "preprod" or "mainnet"
NETWORK=preprod

# Logging verbosity — "debug", "info", "warn", or "error" (default: info)
LOG_LEVEL=info

# ── Stub Mode ────────────────────────────────────────────────────────────────

# Set to "true" to serve hardcoded sample data without running cardano-node,
# Kupo, or Koios. Useful for frontend development and UI work.
USE_STUBS=true

# ── Kupo (local UTxO indexer, managed by Tauri) ─────────────────────────────

# Local Kupo HTTP endpoint. Only needed when USE_STUBS=false.
KUPO_URL=http://localhost:1442

# ── Koios (historical blockchain data) ──────────────────────────────────────

# Koios REST API endpoints. Free tier works without a token.
KOIOS_URL_PREPROD=https://preprod.koios.rest/api/v1
KOIOS_URL_MAINNET=https://api.koios.rest/api/v1

# Optional Koios API tokens for higher rate limits (leave empty for free tier)
KOIOS_TOKEN_PREPROD=
KOIOS_TOKEN_MAINNET=

# ── Contract Configuration ───────────────────────────────────────────────────

# Contract addresses, policy IDs, and reference script UTxOs are managed in
# Tauri's config.json (src-tauri/resources/config.json) — the single source
# of truth. When Tauri starts the Express backend, it injects these as
# environment variables automatically.
#
# For standalone development with USE_STUBS=true, no contract config is needed.
