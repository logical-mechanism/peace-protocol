{
  "name": "veiled-be",
  "version": "0.5.3",
  "description": "Veiled Backend API",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "watch": "tsc --watch --preserveWatchOutput",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.1.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.0.2",
    "globals": "^17.3.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^2.0.0"
  }
}
