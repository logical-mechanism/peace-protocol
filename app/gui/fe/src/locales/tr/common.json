  "tutorial": {
    "skip": "Atla",
    "skipTutorial": "Öğreticiyi atla",
    "finish": "Bitir",
    "stepAria": "Öğretici adımı",
    "listing": {
      "step1Title": "İlan Oluştur",
      "step1Desc": "İlan formunu açmak için bu düğmeye tıklayın. Metin içeriğini zincir üstünde listeleyebilir veya şifrelenmiş dosyaları Iagon aracılığıyla yükleyebilirsiniz.",
      "step2Title": "Veri Türünü Seçin",
      "step2Desc": "İlanınızın metin (zincir üstünde depolanır) mi yoksa dosya (şifrelenerek Iagon'a yüklenir) mı içerdiğini seçin.",
      "step3Title": "Açıklama Ekleyin",
      "step3Desc": "Alıcıların ne satın aldıklarını bilmeleri için net bir açıklama yazın. Bu, pazar yerindeki herkes tarafından görülebilir.",
      "step4Title": "Fiyatınızı Belirleyin",
      "step4Desc": "ADA cinsinden önerilen bir fiyat girin. Alıcılar herhangi bir tutar teklif edebilir, ancak bu beklentileri belirlemeye yardımcı olur.",
      "step5Title": "Gönder ve İmzala",
      "step5Desc": "İlanınızı gözden geçirin ve gönder'e tıklayın. Cüzdanınız işlemi imzalamanızı isteyecektir."
    },
    "bid": {
      "step1Title": "Teklif Ver",
      "step1Desc": "Teklif yapmak için herhangi bir ilandaki 'Teklif Ver' düğmesine tıklayın. ADA'nız, satıcı kabul edene veya zaman kilidi süresi dolana kadar bir akıllı sözleşmede kilitlenecektir.",
      "step2Title": "Teklif miktarını girin",
      "step2Desc": "Bu, ilan için teklif ettiğiniz ADA miktarıdır. Minimum 2 ADA'dır. Satıcı kabul edene kadar zincir üzerinde kilitlenir.",
      "step3Title": "İsteğe bağlı: Gelecekteki ilan fiyatı",
      "step3Desc": "Bu teklifi kazanırsanız, verileri diğer alıcılar için yeniden listeleyebilirsiniz. Bu, bir sonraki ilan için önerilen fiyatı belirler. Atlamak için boş bırakın.",
      "step4Title": "Teklifinizi gönderin",
      "step4Desc": "Göndermek zincir üzerinde bir teklif tokeni oluşturur ve ADA'nızı kilitler. Satıcı kabul etmediyse zaman kilidi süresi dolduktan sonra iptal edebilirsiniz."
    },
    "firstBidAccepted": {
      "step1Title": "Accept This Bid",
      "step1Desc": "Clicking Accept starts a multi-stage process: your device proves ownership via a zero-knowledge proof (~3 minutes), then two chained transactions rekey the data to the buyer and release their ADA to you.",
      "step2Title": "Generating the SNARK Proof",
      "step2Desc": "Your CPU is computing a zero-knowledge proof that you own the encryption secret. This takes roughly 3 minutes and cannot be safely interrupted — feel free to leave the app open in the background.",
      "step3Title": "Submitting the Chained Re-encryption",
      "step3Desc": "The proof is now on-chain. A second transaction is chaining off the first, rekeying the encryption to the buyer so they alone can decrypt it. This step is much quicker than proving.",
      "step4Title": "Sale Complete",
      "step4Desc": "The buyer's ADA has arrived in your wallet, and the encryption is now locked to their key. Check the History tab for the transaction hashes; this listing will disappear from My Sales once confirmations settle."
    },
    "decrypt": {
      "step1Title": "Decrypt Your Purchase",
      "step1Desc": "Click Decrypt to retrieve and unlock your content. Your wallet signature plus a local SNARK proof verify you're the rightful buyer before the data is revealed.",
      "step2Title": "SNARK Verification",
      "step2Desc": "We compute a zero-knowledge proof locally to prove ownership without exposing your keys. This runs on your machine and can take a moment.",
      "step3Title": "Saved to Library",
      "step3Desc": "Once decryption finishes, your content is saved here in the Library tab. Switch over to view, play, or export what you purchased.",
      "step4Title": "Play, Export, Relist",
      "step4Desc": "Open any item to play media, preview text/PDFs, save a copy to disk with Save As, or relist it for other buyers."
    }
  },
