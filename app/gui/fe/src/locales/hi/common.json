    "listing": {
      "step1Title": "लिस्टिंग बनाएँ",
      "step1Desc": "लिस्टिंग फॉर्म खोलने के लिए इस बटन पर क्लिक करें। आप टेक्स्ट सामग्री on-chain लिस्ट कर सकते हैं या Iagon के माध्यम से एन्क्रिप्टेड फ़ाइलें अपलोड कर सकते हैं।",
      "step2Title": "डेटा प्रकार चुनें",
      "step2Desc": "चुनें कि आपकी लिस्टिंग में टेक्स्ट (on-chain संग्रहीत) है या फ़ाइल (एन्क्रिप्टेड और Iagon पर अपलोड की गई)।",
      "step3Title": "विवरण जोड़ें",
      "step3Desc": "एक स्पष्ट विवरण लिखें ताकि खरीदारों को पता चले कि वे क्या खरीद रहे हैं। यह मार्केटप्लेस पर सभी को दिखाई देता है।",
      "step4Title": "अपनी कीमत निर्धारित करें",
      "step4Desc": "ADA में एक सुझाई गई कीमत दर्ज करें। खरीदार कोई भी राशि बोली लगा सकते हैं, लेकिन यह अपेक्षाएँ निर्धारित करने में मदद करता है।",
      "step5Title": "सबमिट करें और साइन करें",
      "step5Desc": "अपनी लिस्टिंग की समीक्षा करें और सबमिट पर क्लिक करें। आपका वॉलेट आपको लेनदेन पर हस्ताक्षर करने के लिए कहेगा।"
    },
    "bid": {
      "step1Title": "बोली लगाएं",
      "step1Desc": "प्रस्ताव देने के लिए किसी भी लिस्टिंग पर 'बोली लगाएं' बटन पर क्लिक करें। आपका ADA एक स्मार्ट कॉन्ट्रैक्ट में लॉक हो जाएगा जब तक विक्रेता स्वीकार नहीं करता या टाइमलॉक समाप्त नहीं हो जाता।",
      "step2Title": "अपनी बोली राशि दर्ज करें",
      "step2Desc": "यह वह ADA राशि है जो आप लिस्टिंग के लिए प्रस्तावित कर रहे हैं। न्यूनतम 2 ADA है। यह ऑन-चेन लॉक हो जाती है जब तक विक्रेता स्वीकार नहीं करता।",
      "step3Title": "वैकल्पिक: भविष्य की कीमत",
      "step3Desc": "यदि आप यह बोली जीतते हैं, तो आप डेटा को अन्य खरीदारों के लिए फिर से सूचीबद्ध कर सकते हैं। यह अगली लिस्टिंग के लिए सुझाई गई कीमत निर्धारित करता है। छोड़ने के लिए खाली छोड़ दें।",
      "step4Title": "अपनी बोली सबमिट करें",
      "step4Desc": "सबमिट करने से ऑन-चेन एक बोली टोकन बनता है और आपका ADA लॉक हो जाता है। यदि विक्रेता ने स्वीकार नहीं किया है तो आप टाइमलॉक अवधि समाप्त होने के बाद रद्द कर सकते हैं।"
    },
    "firstBidAccepted": {
      "step1Title": "Accept This Bid",
      "step1Desc": "Clicking Accept starts a multi-stage process: your device proves ownership via a zero-knowledge proof (~3 minutes), then two chained transactions rekey the data to the buyer and release their ADA to you.",
      "step2Title": "Generating the SNARK Proof",
      "step2Desc": "Your CPU is computing a zero-knowledge proof that you own the encryption secret. This takes roughly 3 minutes and cannot be safely interrupted — feel free to leave the app open in the background.",
      "step3Title": "Submitting the Chained Re-encryption",
      "step3Desc": "The proof is now on-chain. A second transaction is chaining off the first, rekeying the encryption to the buyer so they alone can decrypt it. This step is much quicker than proving.",
      "step4Title": "Sale Complete",
      "step4Desc": "The buyer's ADA has arrived in your wallet, and the encryption is now locked to their key. Check the History tab for the transaction hashes; this listing will disappear from My Sales once confirmations settle."
